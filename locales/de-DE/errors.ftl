# Fehlermeldungen der Engine. Schlüssel: error-<code>; die Codes entsprechen gridcraft_engine::EngineError.
# Originaltext von GridCraft auf Deutsch (de-DE), übersetzt aus dem englischen Referenztext (en-US).

error-unknown-command = Unbekannter Befehl „{ $command }“.
error-command-disabled = „{ $command }“ ist derzeit nicht verfügbar: { $reason }
error-bad-params = Ungültige Parameter für „{ $command }“: { $message }
error-no-document = Es ist keine Arbeitsmappe geöffnet.
error-internal = Interner Fehler in „{ $command }“ (die Arbeitsmappe wurde unverändert belassen): { $message }
error-other = { $message }
error-invalid-formula = Mit dieser Formel besteht ein Problem: { $message }
error-invalid-locale = Die Sprach- oder Regionseinstellungen sind ungültig: { $message }
error-protected-sheet = Diese Änderung ist nicht zulässig: Die Zelle oder das Diagramm befindet sich in einem geschützten Blatt.
